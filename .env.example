# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side Supabase Service Role Key (optional, for durable serverless order/webhook storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Bachs Server-Side Credentials (NEVER prefix with VITE_ or expose to browser)
# Use sk_sandbox_... for sandbox testing or sk_live_... for production
BACHS_API_KEY=sk_sandbox_your_secret_key
BACHS_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
